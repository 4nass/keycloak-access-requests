<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="initial-schema" author="4nass">
        <createTable tableName="AR_ACCESS_REQUEST">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_REQUEST"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTER_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_NAME_SNAPSHOT" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="JUSTIFICATION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="DECISION_STATUS" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="PROVISIONING_STATUS" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ID" type="VARCHAR(255)"/>
            <column name="DECISION_COMMENT" type="TEXT"/>
            <column name="CREATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="DECIDED_TIMESTAMP" type="BIGINT"/>
            <column name="PROVISIONING_CLOSED_TIMESTAMP" type="BIGINT"/>
            <column name="PROVISIONING_CLOSED_BY" type="VARCHAR(255)"/>
            <column name="PROVISIONING_CLOSURE_REASON" type="TEXT"/>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_ACCESS_REQUEST"
                columnNames="REALM_ID, REQUESTER_ID, ENTITLEMENT_ID, DECISION_STATUS"
                constraintName="UK_ACCESS_REQUEST_PENDING"/>

        <createTable tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_REQUEST_HISTORY"/>
            </column>
            <column name="REQUEST_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTOR_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="REQUEST_VERSION" type="BIGINT"/>
            <column name="COMMENT" type="TEXT"/>
            <column name="METADATA" type="TEXT"/>
        </createTable>

        <createTable tableName="AR_ENTITLEMENT">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ENTITLEMENT"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DISPLAY_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="RISK_LEVEL" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ROLE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTABLE" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_ENTITLEMENT"
                columnNames="REALM_ID, RESOURCE_TYPE, RESOURCE_ID"
                constraintName="UK_ENTITLEMENT_RESOURCE"/>

        <createTable tableName="AR_ACCESS_PACKAGE">
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_PACKAGE"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="GROUP_ID" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_ACCESS_PACKAGE_GROUP_ID"/>
            </column>
            <column name="GROUP_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="AR_ACCESS_PACKAGE" columnNames="REALM_ID, GROUP_NAME"
                constraintName="UK_ACCESS_PACKAGE_GROUP_NAME"/>
        <addForeignKeyConstraint baseTableName="AR_ACCESS_PACKAGE" baseColumnNames="ENTITLEMENT_ID"
                referencedTableName="AR_ENTITLEMENT" referencedColumnNames="ID"
                constraintName="FK_ACCESS_PACKAGE_ENTITLEMENT"/>

        <createTable tableName="AR_ACCESS_PACKAGE_ROLE">
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="MAPPING_ORDER" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="AR_ACCESS_PACKAGE_ROLE" columnNames="ENTITLEMENT_ID, MAPPING_ORDER"
                constraintName="PK_ACCESS_PACKAGE_ROLE"/>
        <addUniqueConstraint tableName="AR_ACCESS_PACKAGE_ROLE" columnNames="ENTITLEMENT_ID, ROLE_TYPE, ROLE_ID"
                constraintName="UK_ACCESS_PACKAGE_ROLE"/>
        <addForeignKeyConstraint baseTableName="AR_ACCESS_PACKAGE_ROLE" baseColumnNames="ENTITLEMENT_ID"
                referencedTableName="AR_ACCESS_PACKAGE" referencedColumnNames="ENTITLEMENT_ID"
                constraintName="FK_ACCESS_PACKAGE_ROLE_PACKAGE"/>
        <sql>ALTER TABLE AR_ACCESS_PACKAGE_ROLE ADD CONSTRAINT CK_ACCESS_PACKAGE_ROLE_TYPE
            CHECK (CASE WHEN ROLE_TYPE = 'REALM_ROLE' THEN TRUE
                        WHEN ROLE_TYPE = 'CLIENT_ROLE' THEN TRUE ELSE FALSE END)</sql>

        <createIndex indexName="IDX_ACCESS_REQUEST_REQUESTER_CREATED" tableName="AR_ACCESS_REQUEST">
            <column name="REALM_ID"/>
            <column name="REQUESTER_ID"/>
            <column name="CREATED_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>

        <createIndex indexName="IDX_ACCESS_REQUEST_APPROVAL_QUEUE" tableName="AR_ACCESS_REQUEST">
            <column name="REALM_ID"/>
            <column name="DECISION_STATUS"/>
            <column name="CREATED_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>

        <createTable tableName="AR_ENTITLEMENT_HISTORY">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ENTITLEMENT_HISTORY"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTOR_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DISPLAY_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="RISK_LEVEL" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ROLE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTABLE" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="IDX_ENTITLEMENT_HISTORY_ENTITLEMENT_TIME" tableName="AR_ENTITLEMENT_HISTORY">
            <column name="REALM_ID"/>
            <column name="ENTITLEMENT_ID"/>
            <column name="EVENT_TIMESTAMP"/>
            <column name="ID"/>
        </createIndex>

        <createTable tableName="AR_NOTIFICATION_OUTBOX">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NOTIFICATION_OUTBOX"/>
            </column>
            <column name="DELIVERY_KEY" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUEST_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RECIPIENT_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RECIPIENT_TYPE" type="VARCHAR(20)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
            <column name="NOTIFICATION_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="STATE" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="ATTEMPT_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NEXT_ATTEMPT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_ATTEMPT_TIMESTAMP" type="BIGINT"/>
            <column name="LEASE_UNTIL_TIMESTAMP" type="BIGINT"/>
            <column name="PROCESSOR_ID" type="VARCHAR(36)"/>
            <column name="DELIVERED_TIMESTAMP" type="BIGINT"/>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_NOTIFICATION_OUTBOX"
                columnNames="DELIVERY_KEY"
                constraintName="UK_NOTIFICATION_OUTBOX_DELIVERY"/>

        <createIndex indexName="IDX_NOTIFICATION_OUTBOX_DUE" tableName="AR_NOTIFICATION_OUTBOX">
            <column name="STATE"/>
            <column name="NEXT_ATTEMPT_TIMESTAMP"/>
            <column name="LEASE_UNTIL_TIMESTAMP"/>
        </createIndex>

        <createIndex indexName="IDX_NOTIFICATION_OUTBOX_REALM_STATE_ATTEMPT" tableName="AR_NOTIFICATION_OUTBOX">
            <column name="REALM_ID"/>
            <column name="STATE"/>
            <column name="LAST_ATTEMPT_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>

        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_FAILURE" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="REQUEST_ID"/>
            <column name="EVENT_TYPE"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
            <column name="ID" descending="true"/>
        </createIndex>
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_REALM_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
            <column name="ID" descending="true"/>
        </createIndex>
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_TYPE_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="EVENT_TYPE"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
        </createIndex>
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_ACTOR_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="ACTOR_ID"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
        </createIndex>
        <createTable tableName="AR_ACCESS_GRANT">
            <column name="REQUEST_ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_GRANT"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTER_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DELIVERY_GROUP_ID" type="VARCHAR(255)"/>
            <column name="GRANT_ORIGIN" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RECORDED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="REVOCATION_STATE" type="VARCHAR(30)" defaultValue="UNVERIFIED">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="IDX_ACCESS_GRANT_RESOURCE" tableName="AR_ACCESS_GRANT">
            <column name="REALM_ID"/>
            <column name="REQUESTER_ID"/>
            <column name="RESOURCE_TYPE"/>
            <column name="RESOURCE_ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="entitlement-duration-policy" author="4nass">
        <addColumn tableName="AR_ACCESS_GRANT">
            <column name="EXPIRES_TIMESTAMP" type="BIGINT"/>
        </addColumn>
        <createIndex indexName="IDX_ACCESS_GRANT_DUE_PACKAGE" tableName="AR_ACCESS_GRANT">
            <column name="REVOCATION_STATE"/>
            <column name="GRANT_ORIGIN"/>
            <column name="EXPIRES_TIMESTAMP"/>
            <column name="REQUEST_ID"/>
        </createIndex>
        <addColumn tableName="AR_ACCESS_REQUEST">
            <column name="REQUESTED_DURATION_SECONDS" type="BIGINT"/>
            <column name="PERMANENT" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="AR_ENTITLEMENT">
            <column name="DEFAULT_DURATION_SECONDS" type="BIGINT"/>
            <column name="MAX_DURATION_SECONDS" type="BIGINT"/>
            <column name="ALLOW_PERMANENT" type="BOOLEAN"/>
        </addColumn>
        <addColumn tableName="AR_ENTITLEMENT_HISTORY">
            <column name="DEFAULT_DURATION_SECONDS" type="BIGINT"/>
            <column name="MAX_DURATION_SECONDS" type="BIGINT"/>
            <column name="ALLOW_PERMANENT" type="BOOLEAN"/>
        </addColumn>
        <sql>
            UPDATE AR_ENTITLEMENT SET
                DEFAULT_DURATION_SECONDS = CASE RISK_LEVEL
                    WHEN 'LOW' THEN 2592000 WHEN 'MEDIUM' THEN 604800
                    WHEN 'HIGH' THEN 28800 WHEN 'CRITICAL' THEN 3600 END,
                MAX_DURATION_SECONDS = CASE RISK_LEVEL
                    WHEN 'LOW' THEN 7776000 WHEN 'MEDIUM' THEN 2592000
                    WHEN 'HIGH' THEN 86400 WHEN 'CRITICAL' THEN 14400 END,
                ALLOW_PERMANENT = FALSE;
            UPDATE AR_ENTITLEMENT_HISTORY SET
                DEFAULT_DURATION_SECONDS = CASE RISK_LEVEL
                    WHEN 'LOW' THEN 2592000 WHEN 'MEDIUM' THEN 604800
                    WHEN 'HIGH' THEN 28800 WHEN 'CRITICAL' THEN 3600 END,
                MAX_DURATION_SECONDS = CASE RISK_LEVEL
                    WHEN 'LOW' THEN 7776000 WHEN 'MEDIUM' THEN 2592000
                    WHEN 'HIGH' THEN 86400 WHEN 'CRITICAL' THEN 14400 END,
                ALLOW_PERMANENT = FALSE;
        </sql>
        <addNotNullConstraint tableName="AR_ENTITLEMENT" columnName="DEFAULT_DURATION_SECONDS" columnDataType="BIGINT"/>
        <addNotNullConstraint tableName="AR_ENTITLEMENT" columnName="MAX_DURATION_SECONDS" columnDataType="BIGINT"/>
        <addNotNullConstraint tableName="AR_ENTITLEMENT" columnName="ALLOW_PERMANENT" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="AR_ENTITLEMENT_HISTORY" columnName="DEFAULT_DURATION_SECONDS" columnDataType="BIGINT"/>
        <addNotNullConstraint tableName="AR_ENTITLEMENT_HISTORY" columnName="MAX_DURATION_SECONDS" columnDataType="BIGINT"/>
        <addNotNullConstraint tableName="AR_ENTITLEMENT_HISTORY" columnName="ALLOW_PERMANENT" columnDataType="BOOLEAN"/>
    </changeSet>
</databaseChangeLog>
