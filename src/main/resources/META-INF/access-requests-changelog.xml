<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="1" author="4nass">
        <createTable tableName="AR_ACCESS_REQUEST">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_REQUEST"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTER_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_NAME_SNAPSHOT" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="JUSTIFICATION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="DECISION_STATUS" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="PROVISIONING_STATUS" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ID" type="VARCHAR(255)"/>
            <column name="DECISION_COMMENT" type="TEXT"/>
            <column name="CREATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="DECIDED_TIMESTAMP" type="BIGINT"/>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_ACCESS_REQUEST"
                columnNames="REALM_ID, REQUESTER_ID, ENTITLEMENT_ID, DECISION_STATUS"
                constraintName="UK_ACCESS_REQUEST_PENDING"/>

        <createTable tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_REQUEST_HISTORY"/>
            </column>
            <column name="REQUEST_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTOR_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="COMMENT" type="TEXT"/>
            <column name="METADATA" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="4nass">
        <createTable tableName="AR_ENTITLEMENT">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ENTITLEMENT"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DISPLAY_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="RISK_LEVEL" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ROLE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTABLE" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_ENTITLEMENT"
                columnNames="REALM_ID, RESOURCE_TYPE, RESOURCE_ID"
                constraintName="UK_ENTITLEMENT_RESOURCE"/>
    </changeSet>

    <changeSet id="3" author="4nass">
        <createIndex indexName="IDX_ACCESS_REQUEST_REQUESTER_CREATED" tableName="AR_ACCESS_REQUEST">
            <column name="REALM_ID"/>
            <column name="REQUESTER_ID"/>
            <column name="CREATED_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="4" author="4nass">
        <createIndex indexName="IDX_ACCESS_REQUEST_APPROVAL_QUEUE" tableName="AR_ACCESS_REQUEST">
            <column name="REALM_ID"/>
            <column name="DECISION_STATUS"/>
            <column name="CREATED_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="5" author="4nass">
        <createTable tableName="AR_ENTITLEMENT_HISTORY">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ENTITLEMENT_HISTORY"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="ACTOR_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_TYPE" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="RESOURCE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DISPLAY_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="RISK_LEVEL" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="APPROVER_ROLE_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUESTABLE" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="IDX_ENTITLEMENT_HISTORY_ENTITLEMENT_TIME" tableName="AR_ENTITLEMENT_HISTORY">
            <column name="REALM_ID"/>
            <column name="ENTITLEMENT_ID"/>
            <column name="EVENT_TIMESTAMP"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="6" author="4nass">
        <createTable tableName="AR_NOTIFICATION_OUTBOX">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NOTIFICATION_OUTBOX"/>
            </column>
            <column name="DELIVERY_KEY" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REQUEST_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITLEMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="RECIPIENT_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NOTIFICATION_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="STATE" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="ATTEMPT_COUNT" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NEXT_ATTEMPT_TIMESTAMP" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="LEASE_UNTIL_TIMESTAMP" type="BIGINT"/>
            <column name="PROCESSOR_ID" type="VARCHAR(36)"/>
            <column name="DELIVERED_TIMESTAMP" type="BIGINT"/>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="AR_NOTIFICATION_OUTBOX"
                columnNames="DELIVERY_KEY"
                constraintName="UK_NOTIFICATION_OUTBOX_DELIVERY"/>

        <createIndex indexName="IDX_NOTIFICATION_OUTBOX_DUE" tableName="AR_NOTIFICATION_OUTBOX">
            <column name="STATE"/>
            <column name="NEXT_ATTEMPT_TIMESTAMP"/>
            <column name="LEASE_UNTIL_TIMESTAMP"/>
        </createIndex>
    </changeSet>

    <changeSet id="7" author="4nass">
        <addColumn tableName="AR_NOTIFICATION_OUTBOX">
            <column name="RECIPIENT_TYPE" type="VARCHAR(20)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="8" author="4nass">
        <addColumn tableName="AR_NOTIFICATION_OUTBOX">
            <column name="LAST_ATTEMPT_TIMESTAMP" type="BIGINT"/>
        </addColumn>

        <createIndex indexName="IDX_NOTIFICATION_OUTBOX_REALM_STATE_ATTEMPT" tableName="AR_NOTIFICATION_OUTBOX">
            <column name="REALM_ID"/>
            <column name="STATE"/>
            <column name="LAST_ATTEMPT_TIMESTAMP" descending="true"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="9" author="4nass">
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_FAILURE" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="REQUEST_ID"/>
            <column name="EVENT_TYPE"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
            <column name="ID" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="10" author="4nass">
        <addColumn tableName="AR_ACCESS_REQUEST">
            <column name="PROVISIONING_CLOSED_TIMESTAMP" type="BIGINT"/>
            <column name="PROVISIONING_CLOSED_BY" type="VARCHAR(255)"/>
            <column name="PROVISIONING_CLOSURE_REASON" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="11" author="4nass">
        <addColumn tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REQUEST_VERSION" type="BIGINT"/>
        </addColumn>
    </changeSet>
    <changeSet id="12" author="4nass">
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_REALM_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
            <column name="ID" descending="true"/>
        </createIndex>
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_TYPE_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="EVENT_TYPE"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
        </createIndex>
        <createIndex indexName="IDX_ACCESS_REQUEST_HISTORY_ACTOR_TIME" tableName="AR_ACCESS_REQUEST_HISTORY">
            <column name="REALM_ID"/>
            <column name="ACTOR_ID"/>
            <column name="EVENT_TIMESTAMP" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
